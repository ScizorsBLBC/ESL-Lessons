# ESL Lessons Hub - Backend-for-Frontend (BFF) Proxy Server
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3001
NODE_ENV=development

# Google Gemini API (for generating Olena PMP vocabulary sentences locally)
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: gemini-3.1-pro-preview (default), GEMINI_THINKING_LEVEL=high

# DeepL Translation API
# Get your API key from: https://www.deepl.com/pro-api
# Free tier: 500,000 characters/month
DEEPL_API_KEY=your_deepl_api_key_here

# CORS Configuration (for production)
# ALLOWED_ORIGINS=https://esl-lessons.scizors.wtf

# Security Headers (for production)
# ENABLE_SECURITY_HEADERS=true
